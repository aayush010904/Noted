.hero-card,
.col {
}

.eyebrow {
    display: inline-block;
    margin: 0 0 1rem;
    padding: 0.4rem 0.8rem;
    border-radius: 0.25rem;
    background: var(--accent-light);
    color: var(--accent-primary);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    width: fit-content;
}

.hero-banner h1 {
    margin: 0 0 0.75rem;
    font-size: 1.75rem;
    line-height: 1.3;
    color: var(--text-primary);
    font-weight: 600;
}

@media (max-width: 768px) {
    .hero-banner h1 {
        font-size: 1rem;
    }
}

.hero-copy {
    margin: 0;
    color: var(--95rem;
    line-height: 1.6m;
    line-height: 1.8;
}

.hero-card {
    padding: 1.5rem;light);
    color: var(--accent-primary)var(--accent-primary);
    color: white;
}

.hero-card-label {
    display: inline-block;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--accent-primary);
    background: transparent;
    color: var(--accent-primary);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    width: fit-content;
    border-radius: 0.25rem;
}

.hero-card strong {
    font-size: 1.1rem;
    display: block;
    font-weight: 600;
    margin-bottom: 0.5rem;
}

.hero-card p {8
    margin: 0;
    opacity: 0.9;
    font-size: 0.9rem;
}

.row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
}

@media (min-width: 640px) {
    .row {
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    }
}

@media (min-width: 1024px) {
    .row {
        grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
    }
}

.col {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
}

.notes_list_heading {
    margin-bottom: 1.5rem;
}

.notes_list_heading h1 {
    margin: 0;
    font-size: 1.5rem;
    color: var(--text-primary);
    font-weight: 600;
}

.card-header {75rem;
    font-size: 1rem;
    font-weight: 6rem;
    font-weight: 700;
    color: var(--text-primary);
}

.card-body {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.6;
    font-size: 0.95rem;
}

.card-body p {
    margin: 0 0 1rem;
}

.card-footer {
    margin-top: 1.5rem;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
}

.search-bar {
    displ0.75rem;
    flex-wrap: wrap;
    margin: 1.5rem 0;
    align-items: center;
}

.search-bar input {
    flex: 1;
    min-width: 250px;
}

.search-bar button {
    flex-shrink: 0;
}

@media (max-width: 640px) {
    .search-bar {
        flex-direction: column;
    }
    
