    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    border-radius: 0.375rem;
}

.tag-chip:hover {
    background: var(--text-primary);
    color: white;
    border-color: var(--text-primary);
}

.tag-chip-active {
    background: var(--accent-primary);
    color: white;
    border-color: var(--accent-primary ease;
    box-shadow: var(--shadow-sm);
}

.tag-chip:hover {
    background: var(--text-primary);
    color: var(--surface);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--text-primary);
}

.tag-chip-active {
    background: var(--text-primary);
    color: var(--surface);
}

.btn,
.btn-success,
.btn-secondary,
.btn-ghost,
.btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    padding: 0.65rem 1.2rem;
    font: inherit;
    font-weight: 500;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s ease;
    border-radius: 0.5rem;
    text-transform: none;
}

.btn:hover,
.btn-success:hover,
.btn-secondary:hover,
.btn-ghost:hover,
.btn-primary:hover {
    transform: none;
    opacity: 0.9;
}

.btn-primary,
.btn,
.btn-success {
    background: var(--accent-primary);
    color: white;
}

.btn-secondary {
    background: var(--warning);
    color: var(--text-primary);
}

.btn-secondary:hover {
    box-shadow: var(--shadow-md);
}
