}

.btn-ghost:hover {
    background: var(--bg-tertiary);
}

.btn:disabled,
.btn-primary:disabled,
.btn-secondary:disabled,
.btn-success:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

form {
    display: grid;
    gap: 1rem;
}

input[type="text"],
input[type="email"],
input[type="password"],
input[type="search"],
textarea,
select {
    width: 100%;
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
    padding: 0.75rem;
    font: inherit;
    font-size: 0.95rem;
    background: var(--surface);
    color: var(--text-primary);
    transition: all 0.2s ease;
}

input[type="text"]:focus,
input[type="email"]:focus,
input[type="password"]:focus,
input[type="search"]:focus,
textarea:focus,
select:focus {
    outline: none;
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 3px var(--accent-light);
}

input::placeholder {
    color: var(--text-muted);
}

textarea {
    min-height: 120px;
    resize: vertical;
    font-family: inherit;
}

.home-holder {
    text-align: center;
    padding: 2rem 1rem;
}

.home-holder h1 {
    margin: 0 0 1rem;
    font-size: 2rem;
    line-height: 1.3;
    color: var(--text-primary);
    font-weight: 600;
}

@media (max-width: 768px) {
    .home-holder h1 {
        font-size: 1.25rem;
    }
}

.home-holder p {
    color: var(1rem;
    max-width: 50ch;
    margin: 0.75rem auto 2rem;
    line-height: 1.6uto 2rem;
    line-height: 1.8;
}

.centered-layout {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
    margin-bottom: 2rem;
}

.centered-card {
    max-width: 450px;
    width: 100%;
}

.wide-card {
    max-width: 700px;
    width: 100%;
}

.form-group {
    text-align: left;
    margin-top: 1rem;
}

.form-group p {
    margin-bottom: 1rem;
}

.full-btn {
    width: 100%;
    margin-top: 1rem;
}

/* Responsive Design */
@media (max-width: 768px) {
    .topbar {
        flex-direction: column;
        align-items: flex-start;
        padding: 0.75rem 1rem;
        gap: 0.75rem;
    }

    .topnav {
        width: 100%;
        justify-content: flex-start;
    }

    .page-shell {
        padding: 1.5rem 1rem;
    }

    .hero-banner h1 {
        font-size: 1.5rem;
    }

    .row {
        gap: 1rem;
    }

    .search-bar {
        flex-direction: column;
        gap: 0.5rem;
    }

    .search-bar input {
        min-width: 100%;
    }

    .card-footer {
        flex-direction: column;
    }

    .btn,
    .btn-primary,
    .btn-secondary,
    .btn-ghost {
        width: 100%;
    }

    .home-holder h1 {
        font-size: 1.5rem;
    }
}

@media (max-width: 480px) {
    body {
        font-size: 13px;
    }

    .topbar {
        padding: 0.5rem 0.75rem;
    }

    .brand-title {
        font-size: 0.9rem;
    }

    .page-shell {
        padding: 1rem 0.75rem;
    }

    .home-holder {
        padding: 1.5rem 0.75rem;
    }

    .home-holder h1 {
        font-size: 1.25rem;
    }

    .hero-banner h1 {
        font-size: 1.2rem;
    }

    .col {
        padding: 1rem;
    }
}
/* Auth Forms */
.auth-form {
    max-width: 400px;
    margin: 0 auto;
    padding: 2rem;
}

.auth-form .col {
    padding: 0;
    background: none;
    box-shadow: none;
    border: none;
}

.auth-form h1 {
    text-align: center;
    margin-bottom: 2rem;
    font-size: 1.5rem;
}

.auth-form input {
    margin-bottom: 0;
}

.auth-form button {
    width: 100%;
    margin-top: 1.5rem;
}

.form-group {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
}

.form-group label {
    display: block;
    font-weight: 500;
    color: var(--text-primary);
    font-size: 0.9rem;
}

.form-group input,
.form-group select,
.form-group textarea {
    margin-top: 0.25rem;
}

/* Note Detail View */
.note-detail {
    max-width: 800px;
    margin: 0 auto;
}

.note-detail-content {
    color: var(--text-secondary);
    line-height: 1.8;
    font-size: 1rem;
    white-space: pre-wrap;
    word-wrap: break-word;
    margin: 1.5rem 0;
}

/* Utility Classes */
.text-center {
    text-align: center;
}

.mt-1 { margin-top: 0.5rem; }
.mt-2 { margin-top: 1rem; }
.mt-3 { margin-top: 1.5rem; }
.mt-4 { margin-top: 2rem; }

.mb-1 { margin-bottom: 0.5rem; }
.mb-2 { margin-bottom: 1rem; }
.mb-3 { margin-bottom: 1.5rem; }
.mb-4 { margin-bottom: 2rem; }

.text-muted {
    color: var(--text-tertiary);
}

.text-secondary {
    color: var(--text-secondary);
}

.text-primary {
    color: var(--text-primary);
}

.bg-light {
    background: var(--bg-secondary);
}

.border-top {
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
    margin-top: 1rem;
}

/* Error and Success Messages */
.error-message,
.form-errors {
    background: #fee2e2;
    border-left: 4px solid var(--danger);
    color: #991b1b;
    padding: 1rem;
    border-radius: 0.5rem;
    margin-bottom: 1rem;
}

.success-message {
    background: #dcfce7;
    border-left: 4px solid var(--success);
    color: #166534;
    padding: 1rem;
    border-radius: 0.5rem;
    margin-bottom: 1rem;
}

/* Loading State */
.loading {
    opacity: 0.6;
    pointer-events: none;
}

/* Print Styles */
@media print {
    .topbar,
    .search-bar,
    .card-footer {
        display: none;
    }

    .col {
        box-shadow: none;
        border: 1px solid var(--border-color);
        break-inside: avoid;
    }
}
